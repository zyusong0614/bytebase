# Basic Bytebase Dockerfile - Without Informix support
# Multi-stage build for optimal image size

# Stage 1: Frontend build
FROM node:20-alpine AS frontend
WORKDIR /app

# Copy entire project for build context
COPY . .

# Install pnpm and dependencies
WORKDIR /app/frontend
RUN npm install -g pnpm@latest && \
    pnpm install --no-frozen-lockfile

# Build frontend
RUN NODE_OPTIONS="--max_old_space_size=8000" pnpm run release-docker

# Stage 2: Backend build
FROM golang:1.24-bookworm AS backend
WORKDIR /backend

# Install basic dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    make \
    git \
    libkrb5-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy go mod files
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Copy frontend build to correct location for Go embed
COPY --from=frontend /app/frontend/dist ./backend/server/dist

# Build backend with embedded frontend - limit parallelism to avoid OOM
RUN CGO_ENABLED=1 \
    go build -p 1 -tags embed_frontend -ldflags "-w -s" -o ./bytebase-build/bytebase ./backend/bin/server/main.go

# Stage 3: Runtime image
FROM ubuntu:22.04

# Avoid interactive prompts
ENV DEBIAN_FRONTEND=noninteractive

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    curl \
    postgresql-client \
    mysql-client \
    && rm -rf /var/lib/apt/lists/*

# Create bytebase user
RUN useradd -m -s /bin/bash bytebase

# Copy Bytebase binary (with embedded frontend)
COPY --from=backend /backend/bytebase-build/bytebase /usr/local/bin/bytebase

# Create data directory
RUN mkdir -p /var/opt/bytebase && \
    chown -R bytebase:bytebase /var/opt/bytebase

# Switch to bytebase user
USER bytebase
WORKDIR /var/opt/bytebase

# Expose port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=30s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8080/healthz || exit 1

# Start Bytebase
ENTRYPOINT ["/usr/local/bin/bytebase"]
CMD ["--data", "/var/opt/bytebase", "--port", "8080"]