# Bytebase with Informix ODBC Support - Fixed Version
# Multi-stage build for optimal image size
# Platform: linux/amd64 (required for IBM Informix Client SDK)

# Stage 1: Frontend build
FROM node:20-alpine AS frontend
WORKDIR /app

# Copy entire project for build context
COPY . .

# Install pnpm and dependencies
WORKDIR /app/frontend
RUN npm install -g pnpm@latest && \
    pnpm install --no-frozen-lockfile

# Build frontend for Docker release
RUN NODE_OPTIONS="--max_old_space_size=8000" pnpm run release-docker

# Stage 2: Backend build with Informix support (must be x86_64)
FROM --platform=linux/amd64 golang:1.24-bookworm AS backend
WORKDIR /backend

# Install build dependencies including ODBC development libraries and required headers
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    make \
    git \
    libkrb5-dev \
    curl \
    wget \
    unzip \
    build-essential \
    unixodbc \
    unixodbc-dev \
    odbcinst \
    libncurses5 \
    libncurses6 \
    libtinfo5 \
    libtinfo6 \
    default-jre \
    libpam0g \
    libelf1 \
    libc6-dev \
    libstdc++6 \
    libcrypt1 \
    libgcc-s1 \
    libc6 \
    && rm -rf /var/lib/apt/lists/*

# Set up Informix environment variables for build
ENV INFORMIXDIR=/opt/IBM/informix
ENV INFORMIXSERVER=informix
ENV INFORMIXSQLHOSTS=$INFORMIXDIR/etc/sqlhosts
ENV LD_LIBRARY_PATH=$INFORMIXDIR/lib:$INFORMIXDIR/lib/esql:$INFORMIXDIR/lib/cli:$LD_LIBRARY_PATH
ENV CLIENT_LOCALE=en_US.utf8
ENV DB_LOCALE=en_US.utf8
ENV PATH=$INFORMIXDIR/bin:$PATH

# Create Informix directories
RUN mkdir -p $INFORMIXDIR/etc $INFORMIXDIR/lib/cli

# Copy IBM Informix Client SDK
COPY backend/plugin/db/informix/Go_ODBC_Informix_Complete_Package/ibm_sdk/ibm.csdk.4.50.12.Linux.64.x86_64.tar /tmp/

# Create symlinks for compatibility
RUN ln -s /usr/lib/x86_64-linux-gnu/libncurses.so.6 /usr/lib/x86_64-linux-gnu/libncurses.so.5 || true && \
    ln -s /usr/lib/x86_64-linux-gnu/libtinfo.so.6 /usr/lib/x86_64-linux-gnu/libtinfo.so.5 || true && \
    ln -s /usr/lib/x86_64-linux-gnu/libcrypt.so.1 /usr/lib/x86_64-linux-gnu/libcrypt.so || true && \
    ldconfig

# Check library dependencies before SDK installation
RUN echo "Checking library dependencies:" && \
    ldconfig -p | grep -E "(libdl|libcrypt|libpam|libstdc|libm|libgcc_s|libc|libncurses|libelf)" | sort && \
    echo "Library files in /usr/lib/x86_64-linux-gnu/:" && \
    ls -la /usr/lib/x86_64-linux-gnu/ | grep -E "(libdl|libcrypt|libpam|libstdc|libm|libgcc_s|libc|libncurses|libelf)" | head -20

# Install IBM Informix Client SDK
RUN cd /tmp && \
    tar -xf ibm.csdk.4.50.12.Linux.64.x86_64.tar && \
    echo "SDK files extracted:" && \
    ls -la && \
    printf "1\n\n1\ny\n" | ./installclientsdk || echo "SDK installation failed with exit code: $?" && \
    echo "Checking Informix directory after installation:" && \
    ls -la $INFORMIXDIR/ || echo "No Informix directory created"

# Verify SDK installation
RUN echo "Checking SDK installation:" && \
    ls -la $INFORMIXDIR/lib/cli/ 2>/dev/null || echo "CLI directory missing" && \
    find $INFORMIXDIR -name "*.so" -type f | head -10

# Configure ODBC for build environment
RUN echo "[IBM INFORMIX ODBC DRIVER]" > /etc/odbcinst.ini && \
    echo "Description=IBM Informix ODBC Driver" >> /etc/odbcinst.ini && \
    echo "Driver=$INFORMIXDIR/lib/cli/iclit09b.so" >> /etc/odbcinst.ini && \
    echo "Setup=$INFORMIXDIR/lib/cli/iclit09b.so" >> /etc/odbcinst.ini && \
    echo "FileUsage=1" >> /etc/odbcinst.ini && \
    cat /etc/odbcinst.ini

# Copy go mod files first for better caching
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Copy frontend build to correct location for Go embed
COPY --from=frontend /app/frontend/dist ./backend/server/dist

# Build backend with embedded frontend and Informix support
# Use minimal build with only PostgreSQL + Informix drivers
RUN CGO_ENABLED=1 \
    CGO_CFLAGS="-I$INFORMIXDIR/incl" \
    CGO_LDFLAGS="-L$INFORMIXDIR/lib/cli -lodbc" \
    go build -p 8 -tags "embed_frontend informix" -ldflags "-w -s" \
    -o ./bytebase-build/bytebase ./backend/bin/server/main.go

# Stage 3: Runtime image (must be x86_64 for Informix libraries)
FROM --platform=linux/amd64 ubuntu:22.04

# Avoid interactive prompts
ENV DEBIAN_FRONTEND=noninteractive

# Install runtime dependencies including ODBC, PostgreSQL and debugging tools
RUN apt-get update && apt-get install -y \
    ca-certificates \
    curl \
    postgresql \
    postgresql-client \
    postgresql-contrib \
    mysql-client \
    unixodbc \
    odbcinst \
    libncurses5 \
    libncurses6 \
    libtinfo5 \
    libtinfo6 \
    binutils \
    && rm -rf /var/lib/apt/lists/*

# Set up Informix environment in runtime
ENV INFORMIXDIR=/opt/IBM/informix
ENV INFORMIXSERVER=informix
ENV INFORMIXSQLHOSTS=$INFORMIXDIR/etc/sqlhosts
ENV LD_LIBRARY_PATH=$INFORMIXDIR/lib:$INFORMIXDIR/lib/esql:$INFORMIXDIR/lib/cli:$LD_LIBRARY_PATH
ENV CLIENT_LOCALE=en_US.utf8
ENV DB_LOCALE=en_US.utf8
ENV PATH=$INFORMIXDIR/bin:$PATH

# Copy Informix libraries and configuration from build stage
COPY --from=backend /opt/IBM/informix $INFORMIXDIR/
COPY --from=backend /etc/odbcinst.ini /etc/odbcinst.ini

# Create compatibility symlinks in runtime
RUN ln -s /usr/lib/x86_64-linux-gnu/libncurses.so.6 /usr/lib/x86_64-linux-gnu/libncurses.so.5 || true && \
    ln -s /usr/lib/x86_64-linux-gnu/libtinfo.so.6 /usr/lib/x86_64-linux-gnu/libtinfo.so.5 || true

# Verify ODBC setup in runtime
RUN echo "Runtime ODBC verification:" && \
    cat /etc/odbcinst.ini && \
    ls -la $INFORMIXDIR/lib/cli/ 2>/dev/null || echo "CLI directory missing in runtime"

# Create bytebase user
RUN useradd -m -s /bin/bash bytebase

# Copy Bytebase binary (with embedded frontend and Informix support)
COPY --from=backend /backend/bytebase-build/bytebase /usr/local/bin/bytebase

# Create data directory
RUN mkdir -p /var/opt/bytebase && \
    chown -R bytebase:bytebase /var/opt/bytebase

# Switch to bytebase user
USER bytebase
WORKDIR /var/opt/bytebase

# Expose ports
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=30s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8080/healthz || exit 1

# Start Bytebase
ENTRYPOINT ["/usr/local/bin/bytebase"]
CMD ["--data", "/var/opt/bytebase", "--port", "8080"]