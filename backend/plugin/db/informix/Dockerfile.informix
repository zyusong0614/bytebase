FROM --platform=linux/amd64 ubuntu:20.04

ENV DEBIAN_FRONTEND=noninteractive

# Install basic dependencies
RUN apt-get update && apt-get install -y \
    curl \
    wget \
    unzip \
    build-essential \
    unixodbc \
    unixodbc-dev \
    odbcinst \
    golang-go \
    openjdk-11-jre \
    libncurses5 \
    libtinfo5 \
    && rm -rf /var/lib/apt/lists/*

# Set up workspace
WORKDIR /workspace

# Copy IBM Informix Client SDK
COPY downloads/ibm.csdk.4.50.12.Linux.64.x86_64.tar /workspace/

# Install IBM Informix Client SDK
RUN tar -xf ibm.csdk.4.50.12.Linux.64.x86_64.tar && \
    cd informix && \
    echo -e '1\n\n1\ny' | ./installclientsdk

# Set up Informix environment
ENV INFORMIXDIR=/opt/IBM/informix
ENV INFORMIXSERVER=informix
ENV INFORMIXSQLHOSTS=/opt/IBM/informix/etc/sqlhosts
ENV LD_LIBRARY_PATH=/opt/IBM/informix/lib:/opt/IBM/informix/lib/esql:/opt/IBM/informix/lib/cli:$LD_LIBRARY_PATH
ENV CLIENT_LOCALE=en_US.utf8
ENV DB_LOCALE=en_US.utf8

# Create sqlhosts configuration
RUN mkdir -p /opt/IBM/informix/etc && \
    echo "informix    onsoctcp    172.19.0.2    9088" > /opt/IBM/informix/etc/sqlhosts

# Configure ODBC
RUN echo "[IBM INFORMIX ODBC DRIVER]" > /etc/odbcinst.ini && \
    echo "Description=IBM Informix ODBC Driver" >> /etc/odbcinst.ini && \
    echo "Driver=/opt/IBM/informix/lib/cli/iclit09b.so" >> /etc/odbcinst.ini

RUN echo "[informix_test]" > /etc/odbc.ini && \
    echo "Driver=IBM INFORMIX ODBC DRIVER" >> /etc/odbc.ini && \
    echo "Database=testgo" >> /etc/odbc.ini && \
    echo "LogonID=informix" >> /etc/odbc.ini && \
    echo "pwd=in4mix" >> /etc/odbc.ini && \
    echo "Servername=informix" >> /etc/odbc.ini && \
    echo "Protocol=onsoctcp" >> /etc/odbc.ini && \
    echo "Host=172.19.0.2" >> /etc/odbc.ini

# Set up Go environment
ENV GOROOT=/usr/lib/go-1.16
ENV GOPATH=/home/go
ENV PATH=$GOROOT/bin:$GOPATH/bin:$PATH

WORKDIR /workspace
CMD ["/bin/bash"]